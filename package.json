{
  "name": "three-ssr-fidelity",
  "version": "0.1.0",
  "private": true,
  "description": "Focused stochastic SSR fidelity and GPU performance suite.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm build:fidelity-kit && tsc -b && pnpm build:three && pnpm build:pr34 && pnpm build:hiz && pnpm -r --if-present --filter \"@three-fidelity/*\" build",
    "dev": "pnpm -r --parallel --stream dev",
    "tsc": "tsc -b && pnpm --filter @three-fidelity/playground tsc",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "fidelity-kit",
    "fidelity:dev": "fidelity-kit dev fidelity-results --performance-root performance-results --registry registry.json",
    "fidelity:build": "node scripts/build-site.mjs",
    "live": "pnpm --filter @three-fidelity/playground dev --open /performance.html",
    "build:three": "pnpm --filter ./submodules/three.js build",
    "test:browser": "pnpm --filter @three-fidelity/playground test:browser",
    "performance:run": "node scripts/ssr-run.mjs benchmark",
    "performance:serve": "fidelity-kit serve fidelity-results --performance-root performance-results --registry registry.json",
    "performance:build": "node scripts/build-site.mjs",
    "performance:dev": "fidelity-kit dev fidelity-results --performance-root performance-results --registry registry.json",
    "performance:process": "fidelity-kit process fidelity-results --performance-root performance-results",
    "build:fidelity-kit": "tsc -b submodules/fidelity-kit/packages/cli && pnpm --filter @fidelity-kit/viewer build",
    "site:dev": "fidelity-kit dev fidelity-results --performance-root performance-results --registry registry.json",
    "site:build": "node scripts/build-site.mjs",
    "render": "node scripts/ssr-run.mjs render",
    "test:unified": "node scripts/unified-site-smoke.mjs",
    "performance:representative": "fidelity-kit benchmark --registry registry.json --collection representative --out performance-results --renderer-root render-site",
    "build:pr34": "node scripts/build-three-pr34.mjs",
    "render:experiments": "node scripts/ssr-run.mjs experiments",
    "build:hiz": "node scripts/build-three-hiz.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.10",
    "draco3dgltf": "^1.5.7",
    "fidelity-kit": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "^7",
    "vitest": "^4.1.10",
    "watlas": "^1.0.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,css,html,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.0.8"
}
